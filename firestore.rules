rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function googleUser() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function owner(room) { return signedIn() && get(/databases/$(database)/documents/rooms/$(room)).data.ownerUid == request.auth.uid; }
    function roomAdmin(room) { return googleUser() && request.auth.token.email is string && exists(/databases/$(database)/documents/rooms/$(room)/admins/$(request.auth.token.email)); }
    function manager(room) { return owner(room) || roomAdmin(room); }
    match /public/{publicDoc} {
      allow get: if signedIn() && publicDoc == 'default';
      allow list: if false;
      allow create: if publicDoc == 'default' && googleUser()
        && request.resource.data.keys().hasAll(['room','day','eventId','updatedAt'])
        && request.resource.data.keys().hasOnly(['room','day','eventId','updatedAt'])
        && request.resource.data.room is string
        && request.resource.data.room.matches('^[a-f0-9]{48}$')
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.eventId.matches('^[a-f0-9-]{36}$')
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.room)/days/$(request.resource.data.day)/events/$(request.resource.data.eventId))
        && manager(request.resource.data.room)
        && request.resource.data.updatedAt == request.time;
      allow update: if publicDoc == 'default' && googleUser()
        && manager(resource.data.room) && manager(request.resource.data.room)
        && request.resource.data.keys().hasAll(['room','day','eventId','updatedAt'])
        && request.resource.data.keys().hasOnly(['room','day','eventId','updatedAt'])
        && request.resource.data.room is string
        && request.resource.data.room.matches('^[a-f0-9]{48}$')
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.eventId.matches('^[a-f0-9-]{36}$')
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.room)/days/$(request.resource.data.day)/events/$(request.resource.data.eventId))
        && request.resource.data.updatedAt == request.time;
      allow delete: if publicDoc == 'default' && manager(resource.data.room);
    }
    match /publicEvents/{eventId} {
      allow get: if signedIn() && eventId.matches('^[a-f0-9-]{36}$');
      allow list: if googleUser() && manager(resource.data.room);
      allow create, update: if googleUser()
        && eventId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasAll(['room','day','eventId','updatedAt'])
        && request.resource.data.keys().hasOnly(['room','day','eventId','updatedAt'])
        && request.resource.data.room.matches('^[a-f0-9]{48}$')
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.eventId == eventId
        && manager(request.resource.data.room)
        && request.resource.data.updatedAt == request.time;
      allow delete: if googleUser() && manager(resource.data.room);
    }
    match /rooms/{room} {
      // A random 192-bit invitation ID grants participation. Room enumeration is restricted.
      allow get: if signedIn() && room.matches('^[a-f0-9]{48}$');
      allow list: if googleUser() && resource.data.ownerUid == request.auth.uid;
      allow create: if googleUser() && room.matches('^[a-f0-9]{48}$')
        && request.resource.data.keys().hasAll(['ownerUid','createdAt'])
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /admins/{adminEmail} {
        allow get: if owner(room) || (googleUser() && request.auth.token.email == adminEmail);
        allow list: if owner(room) || (googleUser() && resource.data.email == request.auth.token.email);
        allow create, update: if owner(room)
          && adminEmail == request.resource.data.email
          && request.resource.data.keys().hasAll(['email','name','addedByUid','addedAt'])
          && request.resource.data.keys().hasOnly(['email','name','addedByUid','addedAt'])
          && request.resource.data.email is string
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.addedByUid == request.auth.uid
          && request.resource.data.addedAt == request.time;
        allow delete: if owner(room);
      }
      match /days/{day} {
        function validDay() { return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(room)) && validDay();
        allow create, update: if manager(room) && validDay()
          && request.resource.data.keys().hasAll(['eventName','updatedAt'])
          && request.resource.data.keys().hasOnly(['eventName','updatedAt'])
          && request.resource.data.eventName is string
          && request.resource.data.eventName.size() > 0
          && request.resource.data.eventName.size() <= 100
          && request.resource.data.updatedAt == request.time;
        allow delete: if manager(room) && validDay();
      }
      match /days/{day}/attendance/{mssv} {
        function accessible() {
          return signedIn() && exists(/databases/$(database)/documents/rooms/$(room))
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }
        // Scanner devices may check one known code for duplicate prevention, but only
        // the room owner may enumerate the full attendance list.
        allow get: if accessible();
        allow list: if accessible() && owner(room);
        allow create: if accessible()
          && mssv.matches('^[A-Za-z0-9_-]{1,64}$')
          && request.resource.data.keys().hasAll(['mssv','scannedAt','source','scannerName','requestId','uid','createdAt'])
          && request.resource.data.keys().hasOnly(['mssv','scannedAt','source','scannerName','requestId','uid','createdAt'])
          && request.resource.data.mssv == mssv
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.source in ['camera','manual']
          && request.resource.data.scannerName is string
          && request.resource.data.scannerName.size() > 0
          && request.resource.data.scannerName.size() <= 80
          && request.resource.data.requestId is string && request.resource.data.requestId.size() == 36
          && request.resource.data.scannedAt is string && request.resource.data.scannedAt.size() <= 32
          && request.resource.data.createdAt == request.time;
        // Immutable scan records: duplicate attempts cannot replace the original timestamp or operator.
        allow update: if false;
        allow delete: if accessible() && owner(room);
      }
      match /days/{day}/unread/{photoId} {
        function accessible() {
          return signedIn() && exists(/databases/$(database)/documents/rooms/$(room))
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }
        allow create: if accessible() && photoId.matches('^[a-f0-9-]{36}$')
          && request.resource.data.keys().hasAll(['imageData','scannerName','takenAt','uid','createdAt'])
          && request.resource.data.keys().hasOnly(['imageData','scannerName','takenAt','uid','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.scannerName is string
          && request.resource.data.scannerName.size() > 0
          && request.resource.data.scannerName.size() <= 80
          && request.resource.data.takenAt is string && request.resource.data.takenAt.size() <= 32
          && request.resource.data.imageData is string
          && request.resource.data.imageData.size() > 100
          && request.resource.data.imageData.size() <= 450000
          && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && request.resource.data.createdAt == request.time;
        // The uploader may reopen only their own photo to verify image quality.
        // Listing the queue and deleting/processing photos remain owner-only.
        allow get: if accessible()
          && (owner(room) || resource.data.uid == request.auth.uid);
        allow list, delete: if accessible() && owner(room);
        allow update: if false;
      }
      match /days/{day}/events/{eventId} {
        function validEvent() {
          return signedIn()
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && eventId.matches('^[a-f0-9-]{36}$')
            && exists(/databases/$(database)/documents/rooms/$(room));
        }
        function delegatedManager() {
          return validEvent()
            && exists(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/access/$(request.auth.uid))
            && exists(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/members/$(get(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/access/$(request.auth.uid)).data.memberHash))
            && get(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/access/$(request.auth.uid)).data.memberName
              == get(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/members/$(get(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/access/$(request.auth.uid)).data.memberHash)).data.name;
        }
        function eventManager() { return manager(room) || delegatedManager(); }
        allow get: if validEvent();
        allow list: if manager(room);
        allow create: if manager(room) && validEvent()
          && request.resource.data.keys().hasAll(['eventName','day','createdAt','updatedAt'])
          && request.resource.data.keys().hasOnly(['eventName','day','createdByUid','createdByEmail','createdByName','createdAt','updatedAt'])
          && request.resource.data.eventName is string
          && request.resource.data.eventName.size() > 0
          && request.resource.data.eventName.size() <= 100
          && request.resource.data.day == day
          && (owner(room) || (request.resource.data.keys().hasAll(['createdByUid','createdByEmail','createdByName'])
            && request.resource.data.createdByUid == request.auth.uid
            && request.resource.data.createdByEmail == request.auth.token.email
            && request.resource.data.createdByName is string
            && request.resource.data.createdByName.size() > 0
            && request.resource.data.createdByName.size() <= 100))
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if manager(room) && validEvent()
          && request.resource.data.eventName is string
          && request.resource.data.eventName.size() > 0
          && request.resource.data.eventName.size() <= 100
          && request.resource.data.day == day
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventName','updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if owner(room) || (roomAdmin(room) && resource.data.createdByUid == request.auth.uid);

        match /members/{memberHash} {
          function validMemberPath() {
            return validEvent() && memberHash.matches('^[a-f0-9]{64}$');
          }
          // A scanner may test exactly one SHA-256 name; it may not enumerate names.
          allow get: if validMemberPath();
          allow list: if manager(room);
          allow create: if manager(room) && validMemberPath()
            && request.resource.data.keys().hasAll(['name','normalized','createdAt'])
            && request.resource.data.keys().hasOnly(['name','normalized','createdAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 100
            && request.resource.data.normalized is string
            && request.resource.data.normalized.size() >= 2
            && request.resource.data.normalized.size() <= 100
            && request.resource.data.createdAt == request.time;
          allow update: if manager(room) && validMemberPath()
            && request.resource.data.keys().hasAll(['name','normalized','createdAt'])
            && request.resource.data.keys().hasOnly(['name','normalized','createdAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 100
            && request.resource.data.normalized is string
            && request.resource.data.normalized.size() >= 2
            && request.resource.data.normalized.size() <= 100
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if manager(room);
        }

        match /access/{uid} {
          function validAccess() {
            return validEvent()
              && uid == request.auth.uid
              && request.resource.data.keys().hasAll(['uid','memberHash','memberName','grantedAt'])
              && request.resource.data.keys().hasOnly(['uid','memberHash','memberName','grantedAt'])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.memberHash.matches('^[a-f0-9]{64}$')
              && exists(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/members/$(request.resource.data.memberHash))
              && request.resource.data.memberName == get(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/members/$(request.resource.data.memberHash)).data.name
              && request.resource.data.grantedAt == request.time;
          }
          allow get: if validEvent() && (uid == request.auth.uid || manager(room));
          allow list: if manager(room);
          allow delete: if validEvent() && (uid == request.auth.uid || manager(room));
          allow create, update: if validAccess();
        }

        match /attendance/{mssv} {
          function accessible() { return validEvent(); }
          function validScanner() {
            return request.resource.data.memberHash.matches('^[a-f0-9]{64}$')
              && request.resource.data.memberName is string
              && request.resource.data.memberName.size() >= 2
              && request.resource.data.memberName.size() <= 100;
          }
          allow get: if accessible();
          allow list: if accessible() && eventManager();
          allow create: if accessible()
            && mssv.matches('^[A-Za-z0-9_-]{1,64}$')
            && request.resource.data.keys().hasAll(['mssv','scannedAt','source','memberName','memberHash','eventId','eventName','requestId','uid','createdAt'])
            && request.resource.data.keys().hasOnly(['mssv','scannedAt','source','memberName','memberHash','eventId','eventName','requestId','uid','createdAt'])
            && request.resource.data.mssv == mssv
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.eventId == eventId
            && request.resource.data.eventName == get(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)).data.eventName
            && request.resource.data.source in ['camera','manual']
            && request.resource.data.requestId is string
            && request.resource.data.requestId.size() == 36
            && request.resource.data.scannedAt is string
            && request.resource.data.scannedAt.size() <= 32
            && validScanner()
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if accessible() && eventManager();
        }

        match /unread/{photoId} {
          function accessible() { return validEvent(); }
          function validScanner() {
            return request.resource.data.memberHash.matches('^[a-f0-9]{64}$')
              && request.resource.data.memberName is string
              && request.resource.data.memberName.size() >= 2
              && request.resource.data.memberName.size() <= 100;
          }
          allow create: if accessible()
            && photoId.matches('^[a-f0-9-]{36}$')
            && request.resource.data.keys().hasAll(['imageData','takenAt','memberName','memberHash','eventId','eventName','uid','createdAt'])
            && request.resource.data.keys().hasOnly(['imageData','takenAt','memberName','memberHash','eventId','eventName','uid','createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.eventId == eventId
            && request.resource.data.eventName == get(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)).data.eventName
            && request.resource.data.takenAt is string
            && request.resource.data.takenAt.size() <= 32
            && request.resource.data.imageData is string
            && request.resource.data.imageData.size() > 100
            && request.resource.data.imageData.size() <= 450000
            && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            && validScanner()
            && request.resource.data.createdAt == request.time;
          allow get: if accessible()
            && (eventManager() || resource.data.uid == request.auth.uid);
          allow list: if accessible()
            && (eventManager() || resource.data.uid == request.auth.uid);
          allow delete: if accessible() && manager(room);
          allow update: if accessible()
            && (eventManager() || resource.data.uid == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mssv'])
            && request.resource.data.mssv is string
            && request.resource.data.mssv.matches('^[A-Za-z0-9]{8,12}$')
            && request.resource.data.mssv.matches('.*[0-9].*');
        }
      }
    }
  }
}
