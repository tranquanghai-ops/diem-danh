rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function google(){return signedIn()&&request.auth.token.firebase.sign_in_provider=='google.com';}
  function owner(r){return signedIn()&&get(/databases/$(database)/documents/rooms/$(r)).data.ownerUid==request.auth.uid;}
  function ap(r){return /databases/$(database)/documents/rooms/$(r)/admins/$(request.auth.token.email);}
  function admin(r){return google()&&request.auth.token.email is string&&exists(ap(r));}
  function senior(r){return owner(r)||(admin(r)&&get(ap(r)).data.role=='senior');}
  function manageSubs(r){return owner(r)||(senior(r)&&get(ap(r)).data.canManageSubAdmins==true);}
  function student(){return google()&&request.auth.token.email is string&&request.auth.token.email_verified==true&&request.auth.token.email.matches('^[A-Za-z0-9]+@student\\.tdtu\\.edu\\.vn$');}
  function sap(){return /databases/$(database)/documents/studentAccess/$(request.auth.token.email);}
  function ownStudent(mssv){return student()&&exists(sap())&&get(sap()).data.mssv==mssv;}
  function vr(r){return r.matches('^[a-f0-9]{48}$');}
  function vd(d){return d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');}
  function ve(e){return e.matches('^([a-f0-9]{10}|[a-f0-9-]{36})$');}
  function vc(c){return c.matches('^[A-Za-z0-9-]{1,60}$');}
  match /public/{x}{allow read,write:if false;}
  match /adminAccess/{email}{
   function valid(){return request.resource.data.keys().hasAll(['email','room','name','role','canManageSubAdmins','addedByUid','addedAt'])&&request.resource.data.keys().hasOnly(['email','room','name','role','canManageSubAdmins','addedByUid','addedAt'])&&request.resource.data.email==email&&vr(request.resource.data.room)&&request.resource.data.name is string&&request.resource.data.name.size()<=100&&request.resource.data.role in ['senior','sub']&&request.resource.data.canManageSubAdmins is bool&&(request.resource.data.role=='senior'||request.resource.data.canManageSubAdmins==false)&&request.resource.data.addedByUid==request.auth.uid&&request.resource.data.addedAt==request.time;}
   allow get:if google()&&request.auth.token.email==email;allow list:if false;
   allow create:if google()&&valid()&&(owner(request.resource.data.room)||(manageSubs(request.resource.data.room)&&request.resource.data.role=='sub'));
   allow update:if google()&&valid()&&owner(resource.data.room)&&owner(request.resource.data.room);
   allow delete:if google()&&(owner(resource.data.room)||(manageSubs(resource.data.room)&&resource.data.role=='sub'));
  }
  match /studentAccess/{email}{
   function valid(){return request.resource.data.keys().hasAll(['email','mssv','name','room','updatedByUid','updatedAt'])&&request.resource.data.keys().hasOnly(['email','mssv','name','room','updatedByUid','updatedAt'])&&request.resource.data.email==email&&email.matches('^[a-z0-9]+@student\\.tdtu\\.edu\\.vn$')&&request.resource.data.mssv.matches('^[A-Za-z0-9]{8,12}$')&&request.resource.data.mssv.matches('.*[0-9].*')&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.name.size()<=150&&vr(request.resource.data.room)&&request.resource.data.updatedByUid==request.auth.uid&&request.resource.data.updatedAt==request.time;}
   allow get:if google()&&request.auth.token.email==email;allow list:if false;
   allow create:if google()&&valid()&&senior(request.resource.data.room);
   allow update:if google()&&valid()&&senior(resource.data.room)&&senior(request.resource.data.room);
   allow delete:if google()&&senior(resource.data.room);
  }
  match /publicEvents/{code}{
   function valid(){return vc(code)&&request.resource.data.keys().hasAll(['room','day','eventId','createdByUid','updatedAt'])&&request.resource.data.keys().hasOnly(['room','day','eventId','createdByUid','updatedAt'])&&vr(request.resource.data.room)&&vd(request.resource.data.day)&&ve(request.resource.data.eventId)&&request.resource.data.updatedAt==request.time;}
   function afterEvent(){return getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.room)/days/$(request.resource.data.day)/events/$(request.resource.data.eventId));}
   allow get:if signedIn()&&vc(code);
   allow list:if google()&&(senior(resource.data.room)||(admin(resource.data.room)&&resource.data.createdByUid==request.auth.uid));
   allow create:if google()&&valid()&&afterEvent().data.createdByUid==request.auth.uid&&(senior(request.resource.data.room)||admin(request.resource.data.room));
   allow update:if google()&&valid()&&senior(resource.data.room)&&senior(request.resource.data.room);
   allow delete:if google()&&(senior(resource.data.room)||(admin(resource.data.room)&&resource.data.createdByUid==request.auth.uid));
  }
  match /rooms/{room}{
   allow get:if signedIn()&&vr(room);allow list:if google()&&resource.data.ownerUid==request.auth.uid;
   allow create:if google()&&vr(room)&&request.resource.data.keys().hasAll(['ownerUid','createdAt'])&&request.resource.data.keys().hasOnly(['ownerUid','createdAt'])&&request.resource.data.ownerUid==request.auth.uid&&request.resource.data.createdAt==request.time;allow update,delete:if false;
   match /admins/{email}{
    function valid(){return request.resource.data.keys().hasAll(['email','name','role','canManageSubAdmins','addedByUid','addedAt'])&&request.resource.data.keys().hasOnly(['email','name','role','canManageSubAdmins','addedByUid','addedAt'])&&request.resource.data.email==email&&request.resource.data.name is string&&request.resource.data.name.size()<=100&&request.resource.data.role in ['senior','sub']&&request.resource.data.canManageSubAdmins is bool&&(request.resource.data.role=='senior'||request.resource.data.canManageSubAdmins==false)&&request.resource.data.addedByUid==request.auth.uid&&request.resource.data.addedAt==request.time;}
    allow get:if owner(room)||(google()&&request.auth.token.email==email);allow list:if owner(room)||(manageSubs(room)&&resource.data.role=='sub');
    allow create:if google()&&valid()&&(owner(room)||(manageSubs(room)&&request.resource.data.role=='sub'));allow update:if google()&&valid()&&owner(room);allow delete:if google()&&(owner(room)||(manageSubs(room)&&resource.data.role=='sub'));
   }
   match /students/{mssv}{
    function valid(){return request.resource.data.keys().hasAll(['mssv','name','updatedByUid','updatedAt'])&&request.resource.data.keys().hasOnly(['mssv','name','updatedByUid','updatedAt'])&&request.resource.data.mssv==mssv&&mssv.matches('^[A-Za-z0-9]{8,12}$')&&mssv.matches('.*[0-9].*')&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.name.size()<=150&&request.resource.data.updatedByUid==request.auth.uid&&request.resource.data.updatedAt==request.time;}
    allow get:if signedIn();allow list:if senior(room);
    allow create,update:if google()&&senior(room)&&valid();allow delete:if google()&&senior(room);
   }
   match /studentProfiles/{mssv}{
    function valid(){return request.resource.data.keys().hasAll(['mssv','gender','major','studentClass','updatedByUid','updatedAt'])&&request.resource.data.keys().hasOnly(['mssv','gender','major','studentClass','updatedByUid','updatedAt'])&&request.resource.data.mssv==mssv&&mssv.matches('^[A-Za-z0-9]{8,12}$')&&mssv.matches('.*[0-9].*')&&request.resource.data.gender is string&&request.resource.data.gender.size()<=30&&request.resource.data.major is string&&request.resource.data.major.size()<=120&&request.resource.data.studentClass is string&&request.resource.data.studentClass.size()<=80&&request.resource.data.updatedByUid==request.auth.uid&&request.resource.data.updatedAt==request.time;}
    allow read:if senior(room);allow create,update:if google()&&senior(room)&&valid();allow delete:if google()&&senior(room);
   }
   match /studentDirectory/{document}{
    allow read:if senior(room);
    allow create,update:if google()&&senior(room)&&request.resource.data.keys().hasAll(['groups','count','updatedByUid','updatedAt'])&&request.resource.data.keys().hasOnly(['groups','count','updatedByUid','updatedAt'])&&request.resource.data.groups is list&&request.resource.data.count is int&&request.resource.data.count>=0&&request.resource.data.updatedByUid==request.auth.uid&&request.resource.data.updatedAt==request.time;
    allow delete:if google()&&senior(room);
   }
   match /studentGroups/{document}{
    allow read:if senior(room);
    allow create,update:if google()&&senior(room)&&request.resource.data.keys().hasAll(['records','type','label','major','part','updatedByUid','updatedAt'])&&request.resource.data.keys().hasOnly(['records','type','label','major','part','updatedByUid','updatedAt'])&&request.resource.data.records is list&&request.resource.data.type in ['all','major','class']&&request.resource.data.label is string&&request.resource.data.major is string&&request.resource.data.part is int&&request.resource.data.part>=0&&request.resource.data.updatedByUid==request.auth.uid&&request.resource.data.updatedAt==request.time;
    allow delete:if google()&&senior(room);
   }
   match /days/{day}/events/{eventId}{
    function validEvent(){return signedIn()&&vr(room)&&vd(day)&&ve(eventId)&&exists(/databases/$(database)/documents/rooms/$(room));}
    function ep(){return /databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId);}
    function ev(){return get(ep());}
    function staff(){return senior(room)||(admin(room)&&ev().data.createdByUid==request.auth.uid);}
    function delegated(){return validEvent()&&exists(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/access/$(request.auth.uid))&&exists(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/members/$(get(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/access/$(request.auth.uid)).data.memberHash));}
    function manager(){return staff()||delegated();}
    function open(){return (!ev().data.keys().hasAll(['status'])||ev().data.status=='open')&&(!ev().data.keys().hasAll(['endAt'])||request.time<=ev().data.endAt);}
    function lifecycle(){return request.resource.data.status in ['open','closed']&&request.resource.data.closedByUid is string&&request.resource.data.closedByLevel in ['','senior','sub']&&(request.resource.data.closedAt==null||request.resource.data.closedAt is timestamp)&&request.resource.data.endDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')&&request.resource.data.endAt is timestamp&&request.resource.data.reopenUntil is timestamp&&request.resource.data.endAt<=request.resource.data.reopenUntil;}
    allow get:if validEvent();allow list:if senior(room)||(signedIn()&&resource.data.createdByUid==request.auth.uid);
    allow create:if validEvent()&&(senior(room)||admin(room))&&request.resource.data.keys().hasAll(['eventName','shareCode','day','location','startTime','endTime','createdByUid','createdByEmail','createdByName','status','closedByUid','closedByLevel','closedAt','endDay','endAt','reopenUntil','createdAt','updatedAt'])&&request.resource.data.keys().hasOnly(['eventName','shareCode','day','location','startTime','endTime','createdByUid','createdByEmail','createdByName','status','closedByUid','closedByLevel','closedAt','endDay','endAt','reopenUntil','createdAt','updatedAt'])&&request.resource.data.eventName is string&&request.resource.data.eventName.size()>0&&request.resource.data.eventName.size()<=100&&request.resource.data.shareCode.matches('^[A-Za-z0-9-]{1,60}$')&&request.resource.data.location is string&&request.resource.data.location.size()<=200&&request.resource.data.startTime is string&&request.resource.data.startTime.matches('^$|^([01][0-9]|2[0-3]):[0-5][0-9]$')&&request.resource.data.endTime is string&&request.resource.data.endTime.matches('^$|^([01][0-9]|2[0-3]):[0-5][0-9]$')&&request.resource.data.day==day&&request.resource.data.createdByUid==request.auth.uid&&request.resource.data.createdByEmail==request.auth.token.email&&request.resource.data.createdByName is string&&request.resource.data.createdByName.size()>0&&request.resource.data.createdByName.size()<=100&&request.resource.data.status=='open'&&request.resource.data.closedByUid==''&&request.resource.data.closedByLevel==''&&request.resource.data.closedAt==null&&lifecycle()&&request.resource.data.endAt>=request.time&&request.resource.data.reopenUntil<=request.time+duration.value(11,'d')&&request.resource.data.createdAt==request.time&&request.resource.data.updatedAt==request.time;
    allow update:if validEvent()&&staff()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventName','location','startTime','endTime','status','closedByUid','closedByLevel','closedAt','endDay','endAt','reopenUntil','updatedAt'])&&request.resource.data.eventName is string&&request.resource.data.eventName.size()>0&&request.resource.data.eventName.size()<=100&&request.resource.data.location is string&&request.resource.data.location.size()<=200&&request.resource.data.startTime is string&&request.resource.data.startTime.matches('^$|^([01][0-9]|2[0-3]):[0-5][0-9]$')&&request.resource.data.endTime is string&&request.resource.data.endTime.matches('^$|^([01][0-9]|2[0-3]):[0-5][0-9]$')&&request.resource.data.day==resource.data.day&&request.resource.data.createdByUid==resource.data.createdByUid&&request.resource.data.createdAt==resource.data.createdAt&&lifecycle()&&request.resource.data.updatedAt==request.time&&(!resource.data.keys().hasAll(['status'])||request.resource.data.status!='open'||resource.data.status!='closed'||(request.time<=resource.data.reopenUntil&&(senior(room)||resource.data.closedByLevel!='senior')))&&(request.resource.data.status!='closed'||(request.resource.data.closedByUid==request.auth.uid&&request.resource.data.closedByLevel==(senior(room)?'senior':'sub')&&request.resource.data.closedAt==request.time));
    allow delete:if validEvent()&&staff();
    match /members/{hash}{
     allow get:if validEvent()&&hash.matches('^[a-f0-9]{64}$');allow list:if validEvent()&&staff();
     allow create:if validEvent()&&staff()&&hash.matches('^[a-f0-9]{64}$')&&request.resource.data.keys().hasAll(['name','normalized','createdAt'])&&request.resource.data.keys().hasOnly(['name','normalized','createdAt'])&&request.resource.data.name is string&&request.resource.data.name.size()>=2&&request.resource.data.name.size()<=100&&request.resource.data.normalized is string&&request.resource.data.normalized.size()>=2&&request.resource.data.normalized.size()<=100&&request.resource.data.createdAt==request.time;
     allow update:if validEvent()&&staff()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','normalized']);allow delete:if validEvent()&&staff();
    }
    match /access/{uid}{
     function va(){return validEvent()&&uid==request.auth.uid&&request.resource.data.keys().hasAll(['uid','memberHash','memberName','grantedAt'])&&request.resource.data.keys().hasOnly(['uid','memberHash','memberName','grantedAt'])&&request.resource.data.uid==request.auth.uid&&request.resource.data.memberHash.matches('^[a-f0-9]{64}$')&&exists(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/members/$(request.resource.data.memberHash))&&request.resource.data.memberName==get(/databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/members/$(request.resource.data.memberHash)).data.name&&request.resource.data.grantedAt==request.time;}
     allow get:if validEvent()&&(uid==request.auth.uid||staff());allow list:if validEvent()&&staff();allow create,update:if va();allow delete:if validEvent()&&(uid==request.auth.uid||staff());
    }
    match /attendance/{mssv}{
     function scanner(){return request.resource.data.memberHash.matches('^[a-f0-9]{64}$')&&request.resource.data.memberName is string&&request.resource.data.memberName.size()>=2&&request.resource.data.memberName.size()<=100;}
     function pp(){return /databases/$(database)/documents/rooms/$(room)/days/$(day)/events/$(eventId)/unread/$(request.resource.data.photoId);}
     function photo(){return request.resource.data.source=='photo'&&request.resource.data.keys().hasAll(['photoId'])&&request.resource.data.photoId.matches('^[a-f0-9-]{36}$')&&request.resource.data.uid==get(pp()).data.uid&&request.resource.data.memberName==get(pp()).data.memberName&&request.resource.data.memberHash==get(pp()).data.memberHash&&request.resource.data.scannedAt==get(pp()).data.takenAt&&request.resource.data.requestId==request.resource.data.photoId&&getAfter(pp()).data.mssv==mssv;}
     allow get:if (validEvent()&&!student())||ownStudent(mssv);allow list:if (validEvent()&&manager())||ownStudent(mssv);
     allow create:if validEvent()&&open()&&mssv.matches('^[A-Za-z0-9]{8,12}$')&&request.resource.data.keys().hasAll(['mssv','studentName','room','day','scannedAt','source','memberName','memberHash','eventId','eventName','requestId','uid','createdAt'])&&request.resource.data.keys().hasOnly(['mssv','studentName','room','day','scannedAt','source','photoId','memberName','memberHash','eventId','eventName','requestId','uid','createdAt'])&&request.resource.data.mssv==mssv&&request.resource.data.room==room&&request.resource.data.day==day&&request.resource.data.studentName is string&&request.resource.data.studentName.size()<=150&&((!exists(/databases/$(database)/documents/rooms/$(room)/students/$(mssv))&&request.resource.data.studentName=='')||(exists(/databases/$(database)/documents/rooms/$(room)/students/$(mssv))&&request.resource.data.studentName==get(/databases/$(database)/documents/rooms/$(room)/students/$(mssv)).data.name))&&request.resource.data.eventId==eventId&&request.resource.data.eventName==ev().data.eventName&&scanner()&&request.resource.data.requestId is string&&request.resource.data.requestId.size()==36&&request.resource.data.scannedAt is string&&request.resource.data.scannedAt.size()<=32&&((request.resource.data.source in ['camera','manual']&&request.resource.data.uid==request.auth.uid)||photo())&&request.resource.data.createdAt==request.time;
     allow update:if false;allow delete:if validEvent()&&manager();
    }
    match /unread/{photoId}{
     function scanner(){return request.resource.data.memberHash.matches('^[a-f0-9]{64}$')&&request.resource.data.memberName is string&&request.resource.data.memberName.size()>=2&&request.resource.data.memberName.size()<=100;}
     allow create:if validEvent()&&open()&&photoId.matches('^[a-f0-9-]{36}$')&&request.resource.data.keys().hasAll(['imageData','takenAt','memberName','memberHash','eventId','eventName','uid','createdAt'])&&request.resource.data.keys().hasOnly(['imageData','takenAt','memberName','memberHash','eventId','eventName','uid','createdAt'])&&request.resource.data.uid==request.auth.uid&&request.resource.data.eventId==eventId&&request.resource.data.eventName==ev().data.eventName&&request.resource.data.takenAt is string&&request.resource.data.takenAt.size()<=32&&request.resource.data.imageData is string&&request.resource.data.imageData.size()>100&&request.resource.data.imageData.size()<=450000&&request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')&&scanner()&&request.resource.data.createdAt==request.time;
     allow get:if validEvent()&&(manager()||resource.data.uid==request.auth.uid);allow list:if validEvent()&&(manager()||resource.data.uid==request.auth.uid);allow delete:if validEvent()&&manager();
     allow update:if validEvent()&&open()&&(manager()||resource.data.uid==request.auth.uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mssv'])&&request.resource.data.mssv.matches('^[A-Za-z0-9]{8,12}$')&&request.resource.data.mssv.matches('.*[0-9].*');
    }
    match /roster/{mssv}{
     allow read:if validEvent()&&manager();
     allow create,update:if validEvent()&&staff()&&mssv.matches('^[A-Za-z0-9]{8,12}$')&&request.resource.data.keys().hasAll(['mssv','name','uploadedAt'])&&request.resource.data.keys().hasOnly(['mssv','name','uploadedAt'])&&request.resource.data.mssv==mssv&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.name.size()<=150&&request.resource.data.uploadedAt==request.time;
     allow delete:if validEvent()&&staff();
    }
   }
  }
  match /{path=**}/attendance/{document}{
   allow get,list:if student()&&exists(sap())&&resource.data.mssv==get(sap()).data.mssv;
  }
 }
}
